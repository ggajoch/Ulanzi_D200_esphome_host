@@ -0,0 +1,59 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Grzegorz Gajoch <gajoch@gmail.com>
+Date: Wed, 4 Nov 2026 02:13:42 +0100
+Subject: [PATCH] board: ulanzi: d200: boot with the USB host overlay on
+ request
+
+With usb_mode=host in the saved env, boot the kernel FIT with its
+"usb-host" configuration on top of the panel one, so the kernel gets the
+D200's USB-C port as a USB host. A kernel.itb without that configuration
+boots as before. usb_mode is kept from the saved env.
+
+Signed-off-by: Grzegorz Gajoch <gajoch@gmail.com>
+---
+ board/ulanzi/d200/ulanzi-d200.env    | 14 ++++++++++----
+ configs/ulanzi-d200-rk3308_defconfig |  2 +-
+ 2 files changed, 11 insertions(+), 5 deletions(-)
+
+diff --git a/board/ulanzi/d200/ulanzi-d200.env b/board/ulanzi/d200/ulanzi-d200.env
+index fd77343e..620e51f7 100644
+--- a/board/ulanzi/d200/ulanzi-d200.env
++++ b/board/ulanzi/d200/ulanzi-d200.env
+@@ -15,9 +15,12 @@
+  * or auto) overrides the panel detection. A kernel.itb without these
+  * configurations boots its default one.
+  *
+- * Only slot, upgrade_available, bootcount, ota_result and panel are taken
+- * from the saved env (ENV_WRITEABLE_LIST); everything else always comes
+- * from here.
++ * usb_mode=host also applies the FIT's "usb-host" configuration, which
++ * makes the USB-C port a USB host. A kernel.itb without it boots as usual.
++ *
++ * Only slot, upgrade_available, bootcount, ota_result, panel and usb_mode
++ * are taken from the saved env (ENV_WRITEABLE_LIST); everything else
++ * always comes from here.
+  */
+ slot=a
+ upgrade_available=0
+@@ -32,7 +35,10 @@ boot_b=
+ 	setenv bootargs ${d200_args} root=ubi0:rootfs_b d200.slot=b
+ 		d200.panel=${d200_panel} d200.panel_regs=${d200_panel_regs} &&
+ 	run d200_bootm
+-d200_bootm=bootm ${kernel_addr_r}#${d200_panel} || bootm ${kernel_addr_r}
++d200_bootm=
++	if test "${usb_mode}" = host; then
++		bootm ${kernel_addr_r}#${d200_panel}#usb-host; fi;
++	bootm ${kernel_addr_r}#${d200_panel} || bootm ${kernel_addr_r}
+ d200_boot=
+ 	ubi part ubi;
+ 	if test "${slot}" = b; then run boot_b; run boot_a;
+diff --git a/configs/ulanzi-d200-rk3308_defconfig b/configs/ulanzi-d200-rk3308_defconfig
+index 72185b82..2f3c027e 100644
+--- a/configs/ulanzi-d200-rk3308_defconfig
++++ b/configs/ulanzi-d200-rk3308_defconfig
+@@ -128,4 +128,4 @@ CONFIG_BOOTCOUNT_ENV=y
+ CONFIG_BOOTCOUNT_BOOTLIMIT=3
+ CONFIG_BOOTCOUNT_ALTBOOTCMD="run d200_altboot"
+ CONFIG_ENV_WRITEABLE_LIST=y
+-CONFIG_ENV_FLAGS_LIST_STATIC="slot:sw,upgrade_available:dw,bootcount:dw,ota_result:sw,panel:sw"
++CONFIG_ENV_FLAGS_LIST_STATIC="slot:sw,upgrade_available:dw,bootcount:dw,ota_result:sw,panel:sw,usb_mode:sw"
diff --git a/board/ulanzi/d200/rootfs-overlay/etc/init.d/S01usb-mode b/board/ulanzi/d200/rootfs-overlay/etc/init.d/S01usb-mode
new file mode 100755
index 0000000..c62d316
--- /dev/null
+++ b/board/ulanzi/d200/rootfs-overlay/etc/init.d/S01usb-mode
@@ -0,0 +1,23 @@
+#!/bin/sh
+#
+# ESPHome image (docs/esphome.md): the USB-C port is a USB host by default.
+# U-Boot makes it one when its env has usb_mode=host. If usb_mode is unset
+# (a fresh install), set it, so every boot from the next one on is a host.
+# usb_mode=device keeps the port a USB device.
+#
+
+case "$1" in
+	start)
+		[ -z "$(fw_printenv -n usb_mode 2>/dev/null)" ] || exit 0
+		printf "USB host mode from the next boot on: "
+		if fw_setenv usb_mode host; then
+			echo "OK"
+		else
+			echo "FAIL"
+		fi;;
+	stop|restart|reload)
+		;;
+	*)
+		echo "Usage: $0 {start|stop|restart|reload}"
+		exit 1
+esac
diff --git a/board/ulanzi/d200/rootfs-overlay/etc/init.d/S30usb-gadget b/board/ulanzi/d200/rootfs-overlay/etc/init.d/S30usb-gadget
index 06076e3..f9daa00 100755
--- a/board/ulanzi/d200/rootfs-overlay/etc/init.d/S30usb-gadget
+++ b/board/ulanzi/d200/rootfs-overlay/etc/init.d/S30usb-gadget
@@ -203,6 +203,10 @@ start_network() {
 
 start() {
 	printf "Starting USB gadget: "
+	# the mDNS name, d200-<serial>.local
+	[ -r /proc/device-tree/serial-number ] && hostname "d200-$(serial | tr A-F a-f)"
+	# USB host mode (docs/esphome.md): no device controller, no gadget
+	[ -n "$(ls /sys/class/udc 2>/dev/null)" ] || { echo "no USB device controller, skipped"; return 0; }
 	mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config
 	[ -d $G ] && { echo "already set up"; return 0; }
 
@@ -237,8 +241,6 @@ start() {
 	ln -s configs/c.1 os_desc/
 
 	addresses
-	# the mDNS name, d200-<serial>.local
-	[ -r /proc/device-tree/serial-number ] && hostname "d200-$(serial | tr A-F a-f)"
 	for f in $USB_FUNCTIONS; do
 		[ "$f" = msc ] && ! drive_wanted && continue
 		add_function "$f"
