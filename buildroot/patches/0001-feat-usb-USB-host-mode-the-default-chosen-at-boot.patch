@@ -0,0 +1,50 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Grzegorz Gajoch <gajoch@gmail.com>
+Date: Wed, 4 Nov 2026 02:11:46 +0100
+Subject: [PATCH] arm64: dts: rockchip: add a USB host overlay for the Ulanzi
+ D200
+
+rk3308-ulanzi-d200.dts runs the DWC2 controller behind the D200's USB-C
+port in peripheral mode. Add an overlay that runs it as a host instead.
+
+The board can't supply VBUS; in host mode it has to come from outside,
+e.g. a powered hub.
+
+Signed-off-by: Grzegorz Gajoch <gajoch@gmail.com>
+---
+ arch/arm64/boot/dts/rockchip/Makefile               |  1 +
+ .../dts/rockchip/rk3308-ulanzi-d200-usb-host.dtso   | 13 +++++++++++++
+ 2 files changed, 14 insertions(+)
+ create mode 100644 arch/arm64/boot/dts/rockchip/rk3308-ulanzi-d200-usb-host.dtso
+
+diff --git a/arch/arm64/boot/dts/rockchip/Makefile b/arch/arm64/boot/dts/rockchip/Makefile
+index 86986b954..e1e4c8a63 100644
+--- a/arch/arm64/boot/dts/rockchip/Makefile
++++ b/arch/arm64/boot/dts/rockchip/Makefile
+@@ -21,6 +21,7 @@ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3308-rock-s0.dtb
+ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3308-sakurapi-rk3308b.dtb
+ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3308-ulanzi-d200.dtb
+ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3308-ulanzi-d200-panel-h3.dtbo
++dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3308-ulanzi-d200-usb-host.dtbo
+ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3318-a95x-z2.dtb
+ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3326-anbernic-rg351m.dtb
+ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3326-anbernic-rg351v.dtb
+diff --git a/arch/arm64/boot/dts/rockchip/rk3308-ulanzi-d200-usb-host.dtso b/arch/arm64/boot/dts/rockchip/rk3308-ulanzi-d200-usb-host.dtso
+new file mode 100644
+index 000000000..a6661c1e2
+--- /dev/null
++++ b/arch/arm64/boot/dts/rockchip/rk3308-ulanzi-d200-usb-host.dtso
+@@ -0,0 +1,13 @@
++// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
++/*
++ * Ulanzi D200: the USB-C port as a USB host instead of a USB device. The
++ * board can't supply VBUS; it has to come from outside, e.g. a powered
++ * hub. The bootloader applies this overlay on request.
++ */
++
++/dts-v1/;
++/plugin/;
++
++&{/usb@ff400000} {
++	dr_mode = "host";
++};
diff --git a/board/ulanzi/d200/patches/uboot/2026.10/0022-board-ulanzi-d200-boot-with-the-USB-host-overlay-on-.patch b/board/ulanzi/d200/patches/uboot/2026.10/0022-board-ulanzi-d200-boot-with-the-USB-host-overlay-on-.patch
new file mode 100644
index 0000000..698dd52
--- /dev/null
