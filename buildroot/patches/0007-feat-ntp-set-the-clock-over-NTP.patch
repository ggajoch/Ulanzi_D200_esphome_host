From 98e57311e2158e4068b1c5c7452ca7f6ad280998 Mon Sep 17 00:00:00 2001
From: Grzegorz Gajoch <gajoch@gmail.com>
Date: Wed, 4 Nov 2026 04:36:02 +0100
Subject: [PATCH 7/8] feat(ntp): set the clock over NTP

BusyBox ntpd, supervised by S40ntpd, from pool.ntp.org or the servers in
/data/ntp.conf. It retries until the network is up; until then the clock is
what S00data restored.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 board/ulanzi/d200/busybox.fragment            |  2 +
 .../d200/rootfs-overlay/etc/init.d/S40ntpd    | 60 +++++++++++++++++++
 2 files changed, 62 insertions(+)
 create mode 100755 board/ulanzi/d200/rootfs-overlay/etc/init.d/S40ntpd

diff --git a/board/ulanzi/d200/busybox.fragment b/board/ulanzi/d200/busybox.fragment
index 72342f5..04fd750 100644
--- a/board/ulanzi/d200/busybox.fragment
+++ b/board/ulanzi/d200/busybox.fragment
@@ -5,3 +5,5 @@ CONFIG_UDHCPD=y
 # CONFIG_CRONTAB is not set
 # ubiupdatevol: S00data empties /data when it won't mount or on a device reset
 CONFIG_UBIUPDATEVOL=y
+# ntpd: the clock from the network in USB host mode (S40ntpd)
+CONFIG_NTPD=y
diff --git a/board/ulanzi/d200/rootfs-overlay/etc/init.d/S40ntpd b/board/ulanzi/d200/rootfs-overlay/etc/init.d/S40ntpd
new file mode 100755
index 0000000..4449ecc
--- /dev/null
+++ b/board/ulanzi/d200/rootfs-overlay/etc/init.d/S40ntpd
@@ -0,0 +1,60 @@
+#!/bin/sh
+#
+# ESPHome image (docs/esphome.md): the clock over NTP, from the servers in
+# /data/ntp.conf (one per line) or pool.ntp.org. ntpd retries until the network
+# is up, and is restarted if it exits; logs go to syslog. Until it syncs, the
+# clock is what S00data restored (the saved time or the build time).
+#
+
+CONF=/data/ntp.conf
+PIDFILE=/var/run/ntpd.pid
+
+# -p <server> for each name or address in the config file
+peers() {
+	p=$(sed -n 's/^[[:space:]]*\([A-Za-z0-9.:-][A-Za-z0-9.:-]*\).*/-p \1/p' $CONF 2>/dev/null | tr '\n' ' ')
+	echo "${p:--p pool.ntp.org}"
+}
+
+# Like S60deckd: restart after 1 s, doubling up to 30 s while it keeps dying
+# within 10 s of starting
+supervise() {
+	delay=1
+	while :; do
+		started=$(date +%s)
+		sh -c "set -o pipefail; ntpd -n $(peers) 2>&1 | logger -t ntpd"
+		status=$?
+		[ $(($(date +%s) - started)) -ge 10 ] && delay=1
+		logger -t ntpd "exited with status $status, restarting in ${delay}s"
+		sleep $delay
+		delay=$((delay * 2))
+		[ $delay -gt 30 ] && delay=30
+	done
+}
+
+start() {
+	printf "Starting ntpd: "
+	if start-stop-daemon -S -q -b -m -p $PIDFILE -x /bin/sh -- "$0" supervise; then
+		echo "OK"
+	else
+		echo "FAIL"
+	fi
+}
+
+stop() {
+	printf "Stopping ntpd: "
+	start-stop-daemon -K -q -p $PIDFILE
+	rm -f $PIDFILE
+	killall ntpd 2>/dev/null
+	echo "OK"
+}
+
+case "$1" in
+	start|stop|supervise)
+		"$1";;
+	restart|reload)
+		stop
+		start;;
+	*)
+		echo "Usage: $0 {start|stop|restart|reload}"
+		exit 1
+esac
-- 
