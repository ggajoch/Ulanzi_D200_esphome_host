From 682abe710dcffdd1c8a9fe2071582d4600e4f0ec Mon Sep 17 00:00:00 2001
From: Grzegorz Gajoch <gajoch@gmail.com>
Date: Wed, 4 Nov 2026 04:36:02 +0100
Subject: [PATCH 8/9] feat(ssh): keys only in USB host mode

In USB host mode SSH is reachable over WiFi and Ethernet: dropbear takes
only keys there, from /data/ssh/authorized_keys, and logs a hint when there
are none. In USB device mode, with USB Ethernet to the PC as the only
network, root still logs in without a password.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../d200/rootfs-overlay/etc/default/dropbear    | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/board/ulanzi/d200/rootfs-overlay/etc/default/dropbear b/board/ulanzi/d200/rootfs-overlay/etc/default/dropbear
index 8903389..8502469 100644
--- a/board/ulanzi/d200/rootfs-overlay/etc/default/dropbear
+++ b/board/ulanzi/d200/rootfs-overlay/etc/default/dropbear
@@ -1,2 +1,15 @@
-# USB Ethernet is the only network; root without a password
-DROPBEAR_ARGS="-B -p 22"
+# shellcheck shell=sh disable=SC2034 # DROPBEAR_ARGS is for S50dropbear
+# SSH (docs/esphome.md), sourced by S50dropbear. Keys in
+# /data/ssh/authorized_keys work in both USB modes.
+# - USB device mode: the only network is USB Ethernet to the PC, and root also
+#   logs in without a password.
+# - USB host mode (WiFi, Ethernet adapters): keys only.
+[ -d /data/ssh ] || mkdir -m 700 /data/ssh
+if [ -n "$(ls /sys/class/udc 2>/dev/null)" ]; then
+	DROPBEAR_ARGS="-B -p 22 -D /data/ssh"
+else
+	DROPBEAR_ARGS="-s -p 22 -D /data/ssh"
+	if [ "$1" = start ] && [ ! -s /data/ssh/authorized_keys ]; then
+		logger -t dropbear "no /data/ssh/authorized_keys: SSH accepts no logins in USB host mode; add a key in USB device mode (docs/esphome.md)"
+	fi
+fi
