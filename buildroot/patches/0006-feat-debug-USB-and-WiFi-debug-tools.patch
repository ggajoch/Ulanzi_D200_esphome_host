 BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
 BR2_PACKAGE_WPA_SUPPLICANT_DEBUG_SYSLOG=y
 BR2_PACKAGE_IW=y
+# usbutils needs a libudev
+BR2_PACKAGE_LIBUDEV_ZERO=y
+BR2_PACKAGE_USBUTILS=y
 # pty pair between ESPHome and the display daemon (S70esphome)
 BR2_PACKAGE_SOCAT=y
diff --git a/external.mk b/external.mk
index 6dfb7db..f923983 100644
--- a/external.mk
+++ b/external.mk
@@ -54,3 +54,9 @@ define D200_LINUX_INSTALL_FIRMWARE
 endef
 LINUX_POST_PATCH_HOOKS += D200_LINUX_INSTALL_FIRMWARE
 
+# usbreset (USB port reset by ID or bus/device), which usbutils builds but
+# doesn't install: for re-probing USB devices in host mode (docs/esphome.md)
+define D200_USBUTILS_INSTALL_USBRESET
+	$(INSTALL) -D -m 0755 $(@D)/buildroot-build/usbreset $(TARGET_DIR)/usr/bin/usbreset
+endef
+USBUTILS_POST_INSTALL_TARGET_HOOKS += D200_USBUTILS_INSTALL_USBRESET
