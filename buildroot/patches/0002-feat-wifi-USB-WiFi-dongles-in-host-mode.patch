diff --git a/board/ulanzi/d200/rootfs-overlay/etc/init.d/S32wifi b/board/ulanzi/d200/rootfs-overlay/etc/init.d/S32wifi
new file mode 100755
index 0000000..e4525c4
--- /dev/null
+++ b/board/ulanzi/d200/rootfs-overlay/etc/init.d/S32wifi
@@ -0,0 +1,62 @@
+#!/bin/sh
+#
+# ESPHome image (docs/esphome.md): once a USB WiFi dongle shows up as wlan0
+# (USB host mode), join the network in /data/wpa_supplicant.conf and get an
+# address over DHCP. Logs go to syslog.
+#
+
+CONF=/data/wpa_supplicant.conf
+IFACE=wlan0
+WAIT=30
+PIDFILE=/var/run/wifi.pid
+UDHCPC_PID=/var/run/udhcpc-$IFACE.pid
+
+connect() {
+	for _ in $(seq $WAIT); do
+		[ -e /sys/class/net/$IFACE ] && break
+		sleep 1
+	done
+	if [ ! -e /sys/class/net/$IFACE ]; then
+		logger -t wifi "no $IFACE after ${WAIT}s"
+		return 1
+	fi
+	logger -t wifi "$IFACE is there, starting wpa_supplicant"
+	# -O: wpa_cli works even if the config has no ctrl_interface
+	wpa_supplicant -B -s -i $IFACE -c $CONF -O /var/run/wpa_supplicant || return 1
+	# the hostname lets the router's lease list show the device
+	udhcpc -b -S -i $IFACE -p $UDHCPC_PID -x hostname:"$(hostname)"
+}
+
+start() {
+	printf "Starting WiFi: "
+	if [ ! -r $CONF ]; then
+		logger -t wifi "no $CONF: not starting WiFi"
+		echo "no $CONF, skipped"
+		return 0
+	fi
+	if start-stop-daemon -S -q -b -m -p $PIDFILE -x /bin/sh -- "$0" connect; then
+		echo "OK"
+	else
+		echo "FAIL"
+	fi
+}
+
+stop() {
+	printf "Stopping WiFi: "
+	start-stop-daemon -K -q -p $PIDFILE
+	rm -f $PIDFILE
+	[ -f $UDHCPC_PID ] && kill "$(cat $UDHCPC_PID)" 2>/dev/null
+	wpa_cli -i $IFACE terminate >/dev/null 2>&1
+	echo "OK"
+}
+
+case "$1" in
+	start|stop|connect)
+		"$1";;
+	restart|reload)
+		stop
+		start;;
+	*)
+		echo "Usage: $0 {start|stop|restart|reload}"
+		exit 1
+esac
diff --git a/configs/ulanzi_d200_defconfig b/configs/ulanzi_d200_defconfig
index 76a5317..eb3ec2d 100644
--- a/configs/ulanzi_d200_defconfig
+++ b/configs/ulanzi_d200_defconfig
@@ -89,3 +89,9 @@ BR2_TARGET_ROOTFS_UBIFS_MAXLEBCNT=2048
 # write the image's empty 0xff pages, and NAND pages can't be programmed twice.
 # The root is mounted read-only, so this only matters for a manual remount.
 BR2_TARGET_ROOTFS_UBIFS_OPTS="-F"
+
+# ESPHome image: USB host mode with a WiFi dongle (docs/esphome.md)
+BR2_PACKAGE_WPA_SUPPLICANT=y
+BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
+BR2_PACKAGE_WPA_SUPPLICANT_DEBUG_SYSLOG=y
+BR2_PACKAGE_IW=y
diff --git a/external.mk b/external.mk
index 1a11888..6dfb7db 100644
--- a/external.mk
+++ b/external.mk
@@ -37,10 +37,20 @@ endif
 
 # Reproducible kernel, the same way: kernel.itb only changes with the kernel
 D200_LINUX_INPUTS = board/ulanzi/d200/patches/linux board/ulanzi/d200/linux.config \
-	board/ulanzi/d200/kernel.its
+	board/ulanzi/d200/kernel.its board/ulanzi/d200/firmware
 export D200_LINUX_EPOCH := $(call d200-epoch,$(D200_LINUX_INPUTS))
 LINUX_MAKE_ENV += \
 	KBUILD_BUILD_VERSION=1 \
 	KBUILD_BUILD_USER=d200 \
 	KBUILD_BUILD_HOST=d200 \
 	KBUILD_BUILD_TIMESTAMP="$(shell LC_ALL=C date -u -d @$(D200_LINUX_EPOCH))"
+
+# Firmware built into the kernel (CONFIG_EXTRA_FIRMWARE, from
+# CONFIG_EXTRA_FIRMWARE_DIR="firmware"): in USB host mode, devices probe
+# before the root filesystem is mounted
+define D200_LINUX_INSTALL_FIRMWARE
+	rm -rf $(@D)/firmware
+	cp -r $(BR2_EXTERNAL_D200_BUILDROOT_PATH)/board/ulanzi/d200/firmware $(@D)/firmware
+endef
+LINUX_POST_PATCH_HOOKS += D200_LINUX_INSTALL_FIRMWARE
+
-- 
